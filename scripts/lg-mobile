#!/usr/bin/env bash

set -euo pipefail

die() {
  echo "error: $*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  lg mobile build ios simulator [--from STATE] [PATH ...]
  lg mobile build ios device [--from STATE] [PATH ...]
  lg mobile build android [--from STATE] [PATH ...]
  lg mobile build macos --target-prefix DIR [--from STATE] [PATH ...]
  lg mobile setup ios simulator
  lg mobile setup ios device
  lg mobile setup android

Build options:
  --output-dir DIR             Output root (default: _build/lg-mobile)
  --object-mode complete|partial
                               Include the OCaml runtime or defer it to the host
  --target-prefix DIR          Use an existing target OCaml compiler
  --ocaml-object PATH          Link an additional host object (repeatable)
  --ocaml-include DIR          Add a host interface directory (repeatable)
  --dry-run                    Print resolved targets without building

Environment:
  LG_OCAML_TOOLCHAIN_ROOT      Shared toolchain root
  LG_MOBILE_OCAML_VERSION      OCaml version (default: 5.5.0)
  LG_IOS_DEPLOYMENT_TARGET     iOS deployment target (default: 17.0)
  LG_ANDROID_API_LEVEL         Android API level (default: 21)
  LG_ANDROID_ABI               Android ABI (default: arm64-v8a)
EOF
}

[[ ${1:-} != --help && ${1:-} != -h ]] || {
  usage
  exit 0
}

command=${1:-}
[[ $command == build || $command == setup ]] || {
  usage >&2
  exit 2
}
shift

platform=${1:-}
case "$platform" in
  ios)
    ios_environment=${2:-}
    case "$ios_environment" in
      simulator) targets=(ios-simulator) ;;
      device) targets=(ios-device) ;;
      *) die "iOS requires an environment: simulator or device" ;;
    esac
    shift 2
    ;;
  android)
    targets=(android)
    shift
    ;;
  macos)
    [[ $command == build ]] || die "macOS is available only for build"
    targets=(macos)
    shift
    ;;
  "") die "a mobile platform is required: ios or android" ;;
  *) die "unsupported mobile platform: $platform" ;;
esac

state_path=
output_dir=_build/lg-mobile
object_mode=complete
target_prefix_override=
host_objects=()
host_object_count=0
host_includes=()
host_include_count=0
dry_run=0
inputs=()
input_count=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --from)
      [[ $command == build ]] || die "--from is valid only for build"
      [[ $# -ge 2 ]] || die "--from requires a state path"
      state_path=$2
      shift 2
      ;;
    --output-dir)
      [[ $command == build ]] || die "--output-dir is valid only for build"
      [[ $# -ge 2 ]] || die "--output-dir requires a path"
      output_dir=$2
      shift 2
      ;;
    --object-mode)
      [[ $command == build ]] || die "--object-mode is valid only for build"
      [[ $# -ge 2 ]] || die "--object-mode requires complete or partial"
      object_mode=$2
      case "$object_mode" in
        complete|partial) ;;
        *) die "unsupported object mode: $object_mode" ;;
      esac
      shift 2
      ;;
    --target-prefix)
      [[ $command == build ]] || die "--target-prefix is valid only for build"
      [[ $# -ge 2 && $2 != --* ]] || die "--target-prefix requires a directory"
      target_prefix_override=$2
      shift 2
      ;;
    --ocaml-object)
      [[ $command == build ]] || die "--ocaml-object is valid only for build"
      [[ $# -ge 2 && $2 != --* ]] || die "--ocaml-object requires a path"
      host_objects+=("$2")
      ((host_object_count += 1))
      shift 2
      ;;
    --ocaml-include)
      [[ $command == build ]] || die "--ocaml-include is valid only for build"
      [[ $# -ge 2 && $2 != --* ]] || die "--ocaml-include requires a directory"
      host_includes+=("$2")
      ((host_include_count += 1))
      shift 2
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --*) die "unknown option: $1" ;;
    *)
      [[ $command == build ]] || die "setup does not accept source paths"
      inputs+=("$1")
      ((input_count += 1))
      shift
      ;;
  esac
done

if [[ ${targets[0]} == macos && -z $target_prefix_override ]]; then
  die "macOS requires --target-prefix"
fi

ocaml_version=${LG_MOBILE_OCAML_VERSION:-5.5.0}
ios_deployment_target=${LG_IOS_DEPLOYMENT_TARGET:-17.0}
android_api_level=${LG_ANDROID_API_LEVEL:-21}
android_abi=${LG_ANDROID_ABI:-arm64-v8a}

case "$android_abi" in
  arm64-v8a) android_arch=aarch64 ;;
  x86_64) android_arch=x86_64 ;;
  *) die "unsupported Android ABI: $android_abi" ;;
esac

ios_simulator_triple="arm64-apple-ios${ios_deployment_target}-simulator"
ios_device_triple="arm64-apple-ios${ios_deployment_target}"
android_triple="${android_arch}-linux-android${android_api_level}"

print_plan() {
  local target
  for target in "${targets[@]}"; do
    case "$target" in
      ios-simulator) echo "ios-simulator $ios_simulator_triple" ;;
      ios-device) echo "ios-device $ios_device_triple" ;;
      android) echo "android $android_abi $android_triple" ;;
      macos) echo "macos" ;;
    esac
  done
}

if [[ $dry_run == 1 ]]; then
  print_plan
  exit 0
fi

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

support_command() {
  local source_name=$1
  local installed_name=$2
  if [[ -x $script_dir/mobile/$source_name ]]; then
    echo "$script_dir/mobile/$source_name"
  elif [[ -x $script_dir/$installed_name ]]; then
    echo "$script_dir/$installed_name"
  else
    die "LG mobile support command is missing: $source_name"
  fi
}

bootstrap_ios=$(support_command bootstrap_ios_ocaml.sh lg-mobile-bootstrap-ios)
bootstrap_android=$(support_command bootstrap_android_ocaml.sh lg-mobile-bootstrap-android)
build_dependencies=$(support_command build_lg_dependencies.sh lg-mobile-build-dependencies)

if [[ $command == setup ]]; then
  for target in "${targets[@]}"; do
    case "$target" in
      ios-simulator) "$bootstrap_ios" simulator ;;
      ios-device) "$bootstrap_ios" device ;;
      android) "$bootstrap_android" "$android_abi" ;;
    esac
  done
  exit 0
fi

command -v lg >/dev/null 2>&1 || die "lg was not found"
command -v opam >/dev/null 2>&1 || die "opam was not found"

mkdir -p "$output_dir/generated"
generated_ml="$output_dir/generated/mobile_app.ml"
compile_args=(--target native)
if [[ -n $state_path ]]; then
  compile_args+=(--compile-files-from "$state_path")
else
  compile_args+=(--compile-files)
fi
if [[ $input_count -gt 0 ]]; then
  compile_args+=("${inputs[@]}")
fi
compile_args+=(-o "$generated_ml")
lg "${compile_args[@]}"

opam_root=$(opam var root --safe)
toolchain_root=${LG_OCAML_TOOLCHAIN_ROOT:-$opam_root/lg-ocaml-toolchains}
version_root="$toolchain_root/ocaml-$ocaml_version"

build_object() {
  local name=$1
  local triple=$2
  local runtime_variant=$3
  local prefix="$version_root/targets/$triple"
  if [[ -n $target_prefix_override ]]; then
    prefix=$target_prefix_override
  fi
  local target_dir="$output_dir/$name"
  local ocamlopt="$prefix/bin/ocamlopt.opt"

  [[ -x $ocamlopt ]] || die "shared OCaml toolchain is missing: $prefix; run the matching 'lg mobile setup' command"
  local host_object
  if [[ $host_object_count -gt 0 ]]; then
    for host_object in "${host_objects[@]}"; do
      [[ -f $host_object ]] || die "host OCaml object is missing: $host_object"
    done
  fi
  local host_include
  if [[ $host_include_count -gt 0 ]]; then
    for host_include in "${host_includes[@]}"; do
      [[ -d $host_include ]] || die "host OCaml include directory is missing: $host_include"
    done
  fi
  mkdir -p "$target_dir"
  "$build_dependencies" "$prefix" "$target_dir/dependencies" >/dev/null

  local include_args=()
  while IFS= read -r directory; do
    include_args+=(-I "$directory")
  done <"$target_dir/dependencies/include-directories.txt"
  if [[ $host_object_count -gt 0 ]]; then
    for host_object in "${host_objects[@]}"; do
      include_args+=(-I "$(dirname "$host_object")")
    done
  fi
  if [[ $host_include_count -gt 0 ]]; then
    for host_include in "${host_includes[@]}"; do
      include_args+=(-I "$host_include")
    done
  fi

  "$ocamlopt" "${include_args[@]}" -c "$generated_ml" \
    -o "$target_dir/mobile_app.cmx"

  local dependency_objects=()
  while IFS= read -r object; do
    dependency_objects+=("$object")
  done <"$target_dir/dependencies/link-objects.txt"
  local link_objects=("${dependency_objects[@]}")
  if [[ $host_object_count -gt 0 ]]; then
    link_objects+=("${host_objects[@]}")
  fi

  local output_name=mobile_app_complete.o
  local link_args=(-output-complete-obj -linkall)
  if [[ $object_mode == partial ]]; then
    output_name=mobile_app.o
    link_args=(-output-obj -linkall)
  fi
  [[ $runtime_variant != pic ]] || link_args+=(-runtime-variant _pic)
  "$ocamlopt" "${include_args[@]}" "${link_args[@]}" \
    -o "$target_dir/$output_name" \
    "${link_objects[@]}" \
    "$target_dir/mobile_app.cmx"
  echo "$target_dir/$output_name"
}

for target in "${targets[@]}"; do
  case "$target" in
    ios-simulator) build_object ios-simulator "$ios_simulator_triple" default ;;
    ios-device) build_object ios-device "$ios_device_triple" default ;;
    android) build_object "android/$android_abi" "$android_triple" pic ;;
    macos) build_object macos macos default ;;
  esac
done
