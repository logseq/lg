(rule
 (alias clojure-test-suite-smoke)
 (deps
  clojure_test_suite_smoke_native.exe
  (alias clojure-test-suite-promotion-audit)
  (alias clojure-test-suite-smoke-melange)
  clojure-test-suite-smoke-melange/test/clojure_suite/clojure_test_suite_smoke_melange.js)
 (action
  (progn
   (run %{exe:clojure_test_suite_smoke_native.exe})
   (run
    node
    %{dep:clojure-test-suite-smoke-melange/test/clojure_suite/clojure_test_suite_smoke_melange.js}))))
