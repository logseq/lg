(rule
 (alias clojure-test-suite-promotion-audit)
 (deps
  check_promotion_coverage.py
  compiled_both_namespaces.txt
  promoted_namespaces.txt
  promotion_exclusions.tsv)
 (action
  (run
   python3
   %{dep:check_promotion_coverage.py}
   --compiled
   %{dep:compiled_both_namespaces.txt}
   --promoted
   %{dep:promoted_namespaces.txt}
   --exclusions
   %{dep:promotion_exclusions.tsv})))

; The promoted suite compiles as a shared prefix module plus parallel chunks:
; the base rules compile the clojure.test runtime prefix once and save its
; state; the chunks rules then run one script that fans out N lg_cli
; processes in parallel, each compiling a round-robin slice of the promoted
; namespaces off that state (emitting `include` of the base module instead
; of recompiling the prefix) plus a runner module. Chunk modules append a
; `__clj_smoke_ready` marker which the runner references so module
; initialization order is deterministic before it calls run-tests.

(rule
 (targets clj_smoke_native_base.ml clj_smoke_native_base.state)
 (deps
  ../../stdlib/lg_stdlib_native.state
  ../../test_runner/clojure/test.cljc
  ../../test_runner/clojure/test_native.cljc
  compile_promoted_smoke.py
  scan_clojure_suite.py
  promoted_namespaces.txt
  lg_portability.cljc
  (source_tree ../../src)
  ../../bin/lg_cli.exe)
 (action
  (setenv
   LG_DISABLE_COMPILE_CACHE
   1
   (run
    python3
    %{dep:compile_promoted_smoke.py}
    --mode
    base
    --lg-cli
    %{exe:../../bin/lg_cli.exe}
    --target
    native
    --state
    %{dep:../../stdlib/lg_stdlib_native.state}
    --test-runtime
    %{dep:../../test_runner/clojure/test.cljc}
    --platform-test
    %{dep:../../test_runner/clojure/test_native.cljc}
    --portability
    %{dep:lg_portability.cljc}
    --manifest
    %{dep:promoted_namespaces.txt}
    --emit-state
    clj_smoke_native_base.state
    --working-directory
    %{workspace_root}
    --output
    clj_smoke_native_base.ml
    --open-module
    Lg_stdlib_native))))

(library
 (name clj_smoke_native_base)
 (modes native)
 (wrapped false)
 (modules clj_smoke_native_base)
 (flags
  (:standard -w -26-27-32-37-69))
 (libraries
  lg_compiled_stdlib_native
  lg.runtime
  lg.edn-backend.native
  lg-test.runtime
  lg-test.alcotest
  re
  rrbvec))

(rule
 (targets
  clj_smoke_native_chunk_0.ml
  clj_smoke_native_chunk_1.ml
  clj_smoke_native_chunk_2.ml
  clj_smoke_native_chunk_3.ml
  clj_smoke_native_chunk_4.ml
  clj_smoke_native_chunk_5.ml
  clj_smoke_native_chunk_6.ml
  clj_smoke_native_chunk_7.ml
  clojure_test_suite_smoke_native.ml)
 (deps
  clj_smoke_native_base.state
  .clj_smoke_native_base.objs/byte/clj_smoke_native_base.cmi
  compile_promoted_smoke.py
  scan_clojure_suite.py
  promoted_namespaces.txt
  (source_tree upstream)
  (source_tree ../../src)
  ../../bin/lg_cli.exe)
 (action
  (setenv
   LG_DISABLE_COMPILE_CACHE
   1
   (run
    python3
    %{dep:compile_promoted_smoke.py}
    --mode
    chunks
    --lg-cli
    %{exe:../../bin/lg_cli.exe}
    --target
    native
    --chunk-state
    clj_smoke_native_base.state
    --prefix-interface
    .clj_smoke_native_base.objs/byte/clj_smoke_native_base.cmi
    --suite-dir
    upstream/clojure/core_test
    --manifest
    %{dep:promoted_namespaces.txt}
    --chunks
    8
    --module-prefix
    Clj_smoke_native_chunk_
    --run-module
    Lg_test_alcotest
    --runner-output
    clojure_test_suite_smoke_native.ml
    --working-directory
    %{workspace_root}
    --output
    clj_smoke_native_chunk))))

(executable
 (name clojure_test_suite_smoke_native)
 (modules
  clj_smoke_native_chunk_0
  clj_smoke_native_chunk_1
  clj_smoke_native_chunk_2
  clj_smoke_native_chunk_3
  clj_smoke_native_chunk_4
  clj_smoke_native_chunk_5
  clj_smoke_native_chunk_6
  clj_smoke_native_chunk_7
  clojure_test_suite_smoke_native)
 (flags
  (:standard -w -26-27-32-37-69))
 (libraries
  clj_smoke_native_base
  lg_compiled_stdlib_native
  lg.runtime
  lg.edn-backend.native
  lg-test.runtime
  lg-test.alcotest
  re
  rrbvec))

