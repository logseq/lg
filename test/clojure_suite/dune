(rule
 (alias clojure-test-suite-promotion-audit)
 (deps
  check_promotion_coverage.py
  compiled_both_namespaces.txt
  promoted_namespaces.txt
  promotion_exclusions.tsv)
 (action
  (run
   python3
   %{dep:check_promotion_coverage.py}
   --compiled
   %{dep:compiled_both_namespaces.txt}
   --promoted
   %{dep:promoted_namespaces.txt}
   --exclusions
   %{dep:promotion_exclusions.tsv})))

(rule
 (target clojure_test_suite_smoke_native.ml)
 (deps
  ../../stdlib/lg_stdlib_native.state
  ../../test_runner/clojure/test.cljc
  ../../test_runner/clojure/test_native.cljc
  compile_promoted_smoke.py
  scan_clojure_suite.py
  promoted_namespaces.txt
  lg_portability.cljc
  (source_tree upstream)
  (source_tree ../../src)
  ../../bin/lg_cli.exe)
 (action
  (setenv
   LG_DISABLE_COMPILE_CACHE
   1
   (run
    python3
    %{dep:compile_promoted_smoke.py}
    --lg-cli
    %{exe:../../bin/lg_cli.exe}
    --target
    native
    --state
    %{dep:../../stdlib/lg_stdlib_native.state}
    --test-runtime
    %{dep:../../test_runner/clojure/test.cljc}
    --platform-test
    %{dep:../../test_runner/clojure/test_native.cljc}
    --portability
    %{dep:lg_portability.cljc}
    --suite-dir
    upstream/clojure/core_test
    --manifest
    %{dep:promoted_namespaces.txt}
    --working-directory
    %{workspace_root}
    --output
    %{target}
    --open-module
    Lg_stdlib_native))))

