replace-literal=x bar x
replace-regex=a#b#
replace-captures=$:ab12:12:abcd
replace-first-literal=x foo
replace-first-regex=a#b22
split=["a" "b" "" "c"]
split-limit=["a" "b" "c,d"]
split-empty-source=[""]
split-empty-regex=["" "a" "b" "c"]
split-captures=["a" "1" "b" "2"]
split-zero-limit=["a" "b"]
split-negative-limit=["a" "b" ""]
split-one-limit=["a,b,c"]
