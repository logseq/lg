(ns me.tonsky.persistent-sorted-set.test.arrays
  (:require [me.tonsky.persistent-sorted-set.arrays :as arrays]))

(def values (arrays/array 3 1 2))
(arrays/aset values 1 4)
(println
  (str "basic:"
       (= 3 (arrays/alength values)) ":"
       (= 4 (arrays/aget values 1)) ":"
       (arrays/array? values) ":"
       (= 2 (arrays/alast values)) ":"
       (= 4 (arrays/half 9))))

(def copied (arrays/make-array 4))
(arrays/acopy values 0 2 copied 1)
(println
  (str "copy:"
       (= 3 (arrays/aget copied 1)) ":"
       (= 4 (arrays/aget copied 2)) ":"
       (= [3 4 2] (vec (arrays/aclone values))) ":"
       (= [3 4 2 5] (vec (arrays/aconcat values (arrays/array 5))))))

(def mapped (arrays/amap (fn [value] (* value 2)) values))
(arrays/asort values (fn [left right] (compare left right)))
(println
  (str "transform:"
       (= [6 8 4] (vec mapped)) ":"
       (= [2 3 4] (vec values)) ":"
       (= [3 4] (vec (arrays/aslice values 1 3))) ":"
       (= [7 8] (vec (arrays/into-array [7 8])))))
