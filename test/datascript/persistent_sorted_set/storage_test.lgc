(ns me.tonsky.persistent-sorted-set.test.storage
  (:require
    [me.tonsky.persistent-sorted-set.arrays :as arrays]
    [me.tonsky.persistent-sorted-set.nodes :as nodes]
    [me.tonsky.persistent-sorted-set.set :as pset]))

(defn int-compare [left right]
  (compare left right))

(defn make-memory-storage []
  (let [disk (arrays/make-array 512 None)
        next-address (atom (Int64.of_int 1))
        reads (atom 0)
        writes (atom 0)
        accessed (atom 0)
        deleted (atom 0)
        storage
        (nodes/make-storage
          (fn [address]
            (reset! reads (inc (deref reads)))
            (arrays/aget disk (Int64.to_int address)))
          (fn [_address]
            (Stdlib.ignore (reset! accessed (inc (deref accessed)))))
          (fn [node previous-address]
            (let [address
                  (if-some [existing previous-address]
                    existing
                    (let [fresh (deref next-address)]
                      (reset! next-address (Int64.succ fresh))
                      fresh))
                  snapshot
                  (if (= 0 (nodes/node-child-count node))
                    (nodes/new-restored-leaf
                      (arrays/aclone (nodes/node-keys node))
                      address)
                    (nodes/new-restored-node
                      (arrays/aclone (nodes/node-keys node))
                      (arrays/aclone (nodes/node-addresses node))
                      address))]
              (arrays/aset disk (Int64.to_int address) (Some snapshot))
              (reset! writes (inc (deref writes)))
              address))
          (fn [addresses]
            (Stdlib.ignore
              (reset!
                deleted
                (+ (deref deleted) (arrays/alength addresses))))))]
    (tuple storage reads writes accessed deleted)))

(defn range-set [^:int size]
  (pset/from-sorted-array
    int-compare
    (arrays/into-array (range 0 size))))

(match (make-memory-storage)
  (tuple storage reads writes accessed deleted)
  (let [original (range-set 100)
        root-address (pset/store original storage)
        first-write-count (deref writes)
        repeated-address (pset/store original storage)
        restored (pset/restore-by int-compare root-address storage 1 100)]
    (println
      (str "store:"
           (= 6 first-write-count) ":"
           (= root-address repeated-address) ":"
           (= first-write-count (deref writes))))
    (println
      (str "restore-lazy:"
           (= 0 (deref reads)) ":"
           (= 100 (pset/set-count restored))))
    (println
      (str "lookup-cache:"
           (= 42 (pset/set-lookup restored 42)) ":"
           (= 2 (deref reads)) ":"
           (= 42 (pset/set-lookup restored 42)) ":"
           (= 2 (deref reads)) ":"
           (= 1 (deref accessed))))
    (println
      (str "walk:"
           (= 4950 (pset/set-reduce restored (fn [left right] (+ left right)) 0)) ":"
           (= 6 (deref reads)) ":"
           (= 4950 (pset/set-reduce restored (fn [left right] (+ left right)) 0)) ":"
           (= 6 (deref reads))))
    (let [updated (pset/set-conj restored 100)
          writes-before (deref writes)]
      (pset/store updated storage)
      (println
        (str "incremental:"
             (= 2 (- (deref writes) writes-before)) ":"
             (= 100 (pset/set-lookup updated 100)) ":"
             (nil? (pset/set-lookup restored 100)) ":"
             (= 0 (deref deleted)))))))

(match (make-memory-storage)
  (tuple storage _reads _writes _accessed deleted)
  (let [original (range-set 33)
        root-address (pset/store original storage)
        restored (pset/restore-by int-compare root-address storage 1 33)
        updated (pset/set-disj restored 0)]
    (println
      (str "delete:"
           (= 1 (deref deleted)) ":"
           (nil? (pset/set-lookup updated 0)) ":"
           (= 0 (pset/set-lookup restored 0))))))

(match (make-memory-storage)
  (tuple storage reads writes _accessed _deleted)
  (let [empty (pset/empty-set int-compare)
        root-address (pset/store empty storage)
        restored (pset/restore-by int-compare root-address storage 0 0)]
    (println
      (str "empty:"
           (= 1 (deref writes)) ":"
           (= 0 (deref reads)) ":"
           (= 0 (pset/set-count restored)) ":"
           (nil? (pset/set-lookup restored 0)) ":"
           (= 1 (deref reads))))))
