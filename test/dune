(rule
 (target lgc_native.ml)
 (deps cross_runtime.lgc ../bin/lg_cli.exe)
 (action
  (run
   %{exe:../bin/lg_cli.exe}
   --target
   native
   %{dep:cross_runtime.lgc}
   -o
   %{target})))

(executable
 (name lgc_native)
 (modules lgc_native)
 (libraries lg.runtime rrbvec))

