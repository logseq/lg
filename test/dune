(rule
 (target lgc_native.ml)
 (deps cross_runtime.cljc ../stdlib/lg_stdlib_native.state ../bin/lg_cli.exe)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "open Lg_stdlib_native\n")
    (run
     %{exe:../bin/lg_cli.exe}
     --target
     native
     --compile-chunk-from
     %{dep:../stdlib/lg_stdlib_native.state}
     %{dep:cross_runtime.cljc})))))

