(rule
 (target datascript_value_native.ml)
 (deps
  (source_tree datascript)
  datascript/value.lgc
  datascript/schema.lgc
  datascript_value_test.lgc
  ../bin/lg_cli.exe)
 (action
  (run
   %{exe:../bin/lg_cli.exe}
   --target
   native
   --compile-files
   %{dep:datascript/value.lgc}
   %{dep:datascript/schema.lgc}
   %{dep:datascript_value_test.lgc}
   -o
   %{target})))

(executable
 (name datascript_value_native)
 (modules datascript_value_native)
 (flags (:standard -w -32-37))
 (libraries lg.runtime rrbvec))

