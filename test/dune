(test
 (name compiler_tests)
 (libraries cljml unix rrbvec))

(rule
 (alias runtest)
 (deps
  cli_smoke.sh
  ../bin/cljml_cli.exe
  ../examples/person.cljml
  ../examples/checkout.cljml
  ../examples/protocols.cljml)
 (action
  (run sh %{dep:cli_smoke.sh} %{exe:../bin/cljml_cli.exe}
   %{dep:../examples/person.cljml})))

(rule
 (alias runtest)
 (deps
  no_raw_ir_regression.sh
  (source_tree ../src)
  (source_tree ../docs)
  (source_tree ../test)
  ../README.md
  compiler_tests.ml)
 (action
  (chdir %{workspace_root}
   (run sh test/no_raw_ir_regression.sh))))

