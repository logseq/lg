(rule
 (alias compile-files-from-stdlib)
 (targets
  aggregate_files_chunk.ml
  aggregate_files_chunk.ml.state
  aggregate_files_chunk.ml.with-state.ml)
 (deps
  check_compile_files_from.sh
  aggregate_provider.cljc
  aggregate_consumer.cljc
  ../../stdlib/lg_stdlib_native.state
  ../../bin/lg_cli.exe)
 (action
  (run
   sh
   %{dep:check_compile_files_from.sh}
   %{exe:../../bin/lg_cli.exe}
   %{dep:../../stdlib/lg_stdlib_native.state}
   %{dep:aggregate_provider.cljc}
   %{dep:aggregate_consumer.cljc}
   aggregate_files_chunk.ml)))

