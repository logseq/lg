(rule
 (targets lg_stdlib_native.ml lg_stdlib_native.state)
 (deps
  clojure/core.mil
  clojure/core.cljc
  clojure/string.mil
  clojure/string.cljc
  clojure/edn.mil
  clojure/edn.cljc
  cljs/reader.mil
  cljs/reader.cljc
  clojure/set.mil
  clojure/set.cljc
  %{lib:lg.runtime:lg_runtime.cma}
  ../bin/lg_cli.exe)
 (action
  (setenv
   LG_DISABLE_COMPILE_CACHE
   1
   (run
    %{exe:../bin/lg_cli.exe}
    --target
    native
    --compile-files-state
    lg_stdlib_native.state
    %{dep:clojure/core.mil}
    %{dep:clojure/core.cljc}
    %{dep:clojure/string.mil}
    %{dep:clojure/string.cljc}
    %{dep:clojure/edn.mil}
    %{dep:clojure/edn.cljc}
    %{dep:cljs/reader.mil}
    %{dep:cljs/reader.cljc}
    %{dep:clojure/set.mil}
    %{dep:clojure/set.cljc}
    -o
    lg_stdlib_native.ml))))

(alias
 (name stdlib-native)
 (deps lg_stdlib_native.ml lg_stdlib_native.state))

