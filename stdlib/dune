(rule
 (targets lg_stdlib_native.ml lg_stdlib_native.state)
 (deps
  clojure/core.lgi
  clojure/core.cljc
  clojure/string.lgi
  clojure/string.cljc
  clojure/edn.lgi
  clojure/edn.cljc
  cljs/reader.lgi
  cljs/reader.cljc
  cljs/math.lgi
  cljs/math.cljc
  cljs/cache.cljc
  cljs/pprint.lgi
  cljs/pprint.cljc
  cljs/test.lgi
  cljs/test.cljc
  clojure/core/protocols.cljc
  clojure/set.lgi
  clojure/set.cljc
  clojure/data.lgi
  clojure/data.cljc
  clojure/walk.lgi
  clojure/walk.cljc
  clojure/zip.lgi
  clojure/zip.cljc
  %{lib:lg.runtime:lg_runtime.cma}
  ../bin/lg_cli.exe)
 (action
  (run
   %{exe:../bin/lg_cli.exe}
   --target
   native
   --compile-files-state
   lg_stdlib_native.state
   %{dep:clojure/core.lgi}
   %{dep:clojure/core.cljc}
   %{dep:clojure/string.lgi}
   %{dep:clojure/string.cljc}
   %{dep:clojure/edn.lgi}
   %{dep:clojure/edn.cljc}
   %{dep:cljs/reader.lgi}
   %{dep:cljs/reader.cljc}
   %{dep:cljs/math.lgi}
   %{dep:cljs/math.cljc}
   %{dep:cljs/cache.cljc}
   %{dep:cljs/pprint.lgi}
   %{dep:cljs/pprint.cljc}
   %{dep:cljs/test.lgi}
   %{dep:cljs/test.cljc}
   %{dep:clojure/core/protocols.cljc}
   %{dep:clojure/set.lgi}
   %{dep:clojure/set.cljc}
   %{dep:clojure/data.lgi}
   %{dep:clojure/data.cljc}
   %{dep:clojure/walk.lgi}
   %{dep:clojure/walk.cljc}
   %{dep:clojure/zip.lgi}
   %{dep:clojure/zip.cljc}
   -o
   lg_stdlib_native.ml)))

(alias
 (name stdlib-native)
 (deps lg_stdlib_native.ml lg_stdlib_native.state))

