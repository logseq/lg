(ns clojure.core)

(signature clojure.core/identity [value]
  :fn<value;value>)

(signature clojure.core/complement [value result]
  :fn<fn<value;truthy<result>>;fn<value;bool>>)

(signature clojure.core/boolean [value]
  :fn<truthy<value>;bool>)
(signature clojure.core/not [value]
  :fn<truthy<value>;bool>)
(signature clojure.core/reduced [value]
  :fn<value;Lg_runtime.Runtime_reduced.t<value>>)
(signature clojure.core/subs
  :overload<fn<string;int;string>;fn<string;int;int;string>>)
(signature clojure.core/int-to-string-radix :fn<int;int;string>)
(signature clojure.core/parse-boolean :fn<string;option<bool>>)
(signature clojure.core/any? [value] :fn<value;bool>)
(signature clojure.core/range
  :overload<fn<seq<int>>;fn<int;seq<int>>;fn<int;int;seq<int>>;fn<int;int;int;seq<int>>>)
(signature clojure.core/shuffle [value]
  :fn<seqable<value>;vector<value>>)
(signature clojure.core/alength [array-element]
  :fn<array<array-element>;int>)
(signature clojure.core/acopy [array-element]
  :fn<array<array-element>;int;int;array<array-element>;int;unit>)
(signature clojure.core/aslice [array-element]
  :fn<array<array-element>;int;int;array<array-element>>)
(signature clojure.core/aconcat [array-element]
  :fn<array<array-element>;array<array-element>;array<array-element>>)
(signature clojure.core/array-to-seq [array-element]
  :fn<array<array-element>;seq<array-element>>)
(signature clojure.core/array-to-rseq [array-element]
  :fn<array<array-element>;seq<array-element>>)
(signature clojure.core/asort! [array-element]
  :fn<fn<array-element;array-element;int>;array<array-element>;unit>)

(signature clojure.core/quot :fn<int;int;int>)
(signature clojure.core/rem :fn<int;int;int>)
(signature clojure.core/mod :fn<int;int;int>)
(signature clojure.core/unchecked-add :fn<int;int;int>)
(signature clojure.core/unchecked-add-int :fn<int;int;int>)
(signature clojure.core/unchecked-subtract :fn<int;int;int>)
(signature clojure.core/unchecked-subtract-int :fn<int;int;int>)
(signature clojure.core/unchecked-multiply :fn<int;int;int>)
(signature clojure.core/unchecked-multiply-int :fn<int;int;int>)
(signature clojure.core/unchecked-divide-int :fn<int;int;int>)
(signature clojure.core/unchecked-remainder-int :fn<int;int;int>)
(signature clojure.core/unchecked-inc :fn<int;int>)
(signature clojure.core/unchecked-inc-int :fn<int;int>)
(signature clojure.core/unchecked-dec :fn<int;int>)
(signature clojure.core/unchecked-dec-int :fn<int;int>)
(signature clojure.core/unchecked-negate :fn<int;int>)
(signature clojure.core/unchecked-negate-int :fn<int;int>)
(signature clojure.core/rand-int :fn<int;int>)
(signature clojure.core/rand-nth [value]
  :fn<seqable<value>;value>)
(signature clojure.core/bit-shift-right-zero-fill :fn<int;int;int>)
(signature clojure.core/bit-and-not-two :fn<int;int;int>)
(signature clojure.core/unsigned-bit-shift-right :fn<int;int;int>)
(signature clojure.core/bit-count :fn<int;int>)
(signature clojure.core/second [value]
  :fn<seqable<value>;option<value>>)
(signature clojure.core/last [value]
  :fn<seqable<value>;option<value>>)

(signature clojure.core/even? :fn<int;bool>)
(signature clojure.core/odd? :fn<int;bool>)
(signature clojure.core/every? [value result]
  :fn<fn<value;truthy<result>>;seqable<value>;bool>)
(signature clojure.core/ffirst [value]
  :fn<seqable<seqable<value>>;option<value>>)
(signature clojure.core/fnext [value]
  :fn<seqable<value>;option<value>>)
(signature clojure.core/nfirst [value]
  :fn<seqable<seqable<value>>;seq<value>>)
(signature clojure.core/nnext [value]
  :fn<seqable<value>;seq<value>>)
(signature clojure.core/bit-clear :fn<int;int;int>)
(signature clojure.core/bit-flip :fn<int;int;int>)
(signature clojure.core/bit-set :fn<int;int;int>)
(signature clojure.core/bit-test :fn<int;int;bool>)

(signature clojure.core/not-every? [value result]
  :fn<fn<value;truthy<result>>;seqable<value>;bool>)

(signature clojure.core/not-any? [value result]
  :fn<fn<value;truthy<result>>;seqable<value>;bool>)

(signature clojure.core/split-at [value]
  :fn<int;seqable<value>;vector<seq<value>>>)

(signature clojure.core/split-with [value]
  :fn<fn<value;bool>;seqable<value>;vector<seq<value>>>)

(signature clojure.core/nthnext [value]
  :fn<seqable<value>;int;seq<value>>)

(signature clojure.core/nthrest [value]
  :fn<seqable<value>;int;seq<value>>)

(signature clojure.core/bounded-count [value]
  :fn<int;seqable<value>;int>)

(signature clojure.core/butlast [value]
  :fn<seqable<value>;seq<value>>)

(signature clojure.core/take-last [value]
  :fn<int;seqable<value>;seq<value>>)

(signature clojure.core/drop-last [value]
  :overload<fn<seqable<value>;seq<value>>;fn<int;seqable<value>;seq<value>>>)

(signature clojure.core/reverse [value]
  :fn<seqable<value>;list<value>>)

(signature clojure.core/interpose [value]
  :fn<value;seqable<value>;seq<value>>)

(signature clojure.core/replicate [value]
  :fn<int;value;seq<value>>)

(signature clojure.core/dedupe [value]
  :fn<seqable<value>;seq<value>>)

(signature clojure.core/distinct [value]
  :fn<seqable<value>;list<value>>)

(signature clojure.core/zipmap [key value]
  :fn<seqable<key>;seqable<value>;map<key;value>>)

(signature clojure.core/key [key value]
  :fn<tuple<key;value>;key>)

(signature clojure.core/val [key value]
  :fn<tuple<key;value>;value>)

(signature clojure.core/vec [value]
  :fn<seqable<value>;vector<value>>)

(signature clojure.core/comparator [value result]
  :fn<fn<value;value;truthy<result>>;fn<value;value;int>>)

(signature clojure.core/frequencies [value]
  :fn<seqable<value>;map<value;int>>)

(signature clojure.core/update-vals [key value result]
  :fn<map<key;value>;fn<value;result>;map<key;result>>)

(signature clojure.core/update-keys [key value result]
  :fn<map<key;value>;fn<key;result>;map<result;value>>)

(signature clojure.core/hash-combine :fn<int;int;int>)
