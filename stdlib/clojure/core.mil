(ns clojure.core)

(signature clojure.core/identity [value]
  :fn<value;value>)

(signature clojure.core/complement [value]
  :fn<fn<value;bool>;fn<value;bool>>)

(signature clojure.core/even? :fn<int;bool>)
(signature clojure.core/odd? :fn<int;bool>)
(signature clojure.core/bit-clear :fn<int;int;int>)
(signature clojure.core/bit-flip :fn<int;int;int>)
(signature clojure.core/bit-set :fn<int;int;int>)
(signature clojure.core/bit-test :fn<int;int;bool>)

(signature clojure.core/not-every? [value]
  :fn<fn<value;bool>;seqable<value>;bool>)

(signature clojure.core/not-any? [value]
  :fn<fn<value;bool>;seqable<value>;bool>)

(signature clojure.core/split-at [value]
  :fn<int;seqable<value>;vector<seq<value>>>)

(signature clojure.core/split-with [value]
  :fn<fn<value;bool>;seqable<value>;vector<seq<value>>>)

(signature clojure.core/nthnext [value]
  :fn<seqable<value>;int;seq<value>>)

(signature clojure.core/nthrest [value]
  :fn<seqable<value>;int;seq<value>>)

(signature clojure.core/bounded-count [value]
  :fn<int;seqable<value>;int>)

(signature clojure.core/butlast [value]
  :fn<seqable<value>;seq<value>>)

(signature clojure.core/take-last [value]
  :fn<int;seqable<value>;seq<value>>)

(signature clojure.core/drop-last [value]
  :overload<fn<seqable<value>;seq<value>>;fn<int;seqable<value>;seq<value>>>)

(signature clojure.core/reverse [value]
  :fn<seqable<value>;list<value>>)

(signature clojure.core/interpose [value]
  :fn<value;seqable<value>;seq<value>>)

(signature clojure.core/zipmap [key value]
  :fn<seqable<key>;seqable<value>;map<key;value>>)
