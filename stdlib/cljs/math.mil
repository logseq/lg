(ns cljs.math)

(signature cljs.math/E :float)
(signature cljs.math/PI :float)
(signature cljs.math/DEGREES-TO-RADIANS :float)
(signature cljs.math/RADIANS-TO-DEGREES :float)

(signature cljs.math/sin :fn<float;float>)
(signature cljs.math/cos :fn<float;float>)
(signature cljs.math/tan :fn<float;float>)
(signature cljs.math/asin :fn<float;float>)
(signature cljs.math/acos :fn<float;float>)
(signature cljs.math/atan :fn<float;float>)
(signature cljs.math/to-radians :fn<float;float>)
(signature cljs.math/to-degrees :fn<float;float>)
(signature cljs.math/exp :fn<float;float>)
(signature cljs.math/log :fn<float;float>)
(signature cljs.math/log10 :fn<float;float>)
(signature cljs.math/sqrt :fn<float;float>)
(signature cljs.math/ceil :fn<float;float>)
(signature cljs.math/floor :fn<float;float>)
(signature cljs.math/atan2 :fn<float;float;float>)
(signature cljs.math/sinh :fn<float;float>)
(signature cljs.math/cosh :fn<float;float>)
(signature cljs.math/tanh :fn<float;float>)
(signature cljs.math/hypot :fn<float;float;float>)
(signature cljs.math/expm1 :fn<float;float>)
(signature cljs.math/log1p :fn<float;float>)
(signature cljs.math/cbrt :fn<float;float>)
(signature cljs.math/pow :fn<float;float;float>)
(signature cljs.math/random :fn<float>)
(signature cljs.math/copy-sign :fn<float;float;float>)
(signature cljs.math/rint :fn<float;float>)
(signature cljs.math/signum :fn<float;float>)
(signature cljs.math/round :fn<float;float>)
(signature cljs.math/get-exponent :fn<float;int>)
(signature cljs.math/next-after :fn<float;float;float>)
(signature cljs.math/next-up :fn<float;float>)
(signature cljs.math/next-down :fn<float;float>)
(signature cljs.math/ulp :fn<float;float>)
(signature cljs.math/scalb :fn<float;int;float>)
(signature cljs.math/IEEE-remainder :fn<float;float;float>)
