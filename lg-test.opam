# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Clojure-compatible test runner for CljML"
description:
  "A Clojure.test-compatible test runner with Alcotest and Melange backends."
maintainer: ["Tienson Qin <tiensonqin@gmail.com>"]
authors: ["Tienson Qin"]
license: "MIT"
homepage: "https://github.com/tiensonqin/lg"
bug-reports: "https://github.com/tiensonqin/lg/issues"
depends: [
  "ocaml" {>= "5.4"}
  "dune" {>= "3.17" & >= "3.17"}
  "melange" {>= "6.0"}
  "alcotest"
  "lg"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
