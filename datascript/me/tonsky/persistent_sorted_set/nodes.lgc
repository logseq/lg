(ns me.tonsky.persistent-sorted-set.nodes
  (:require
    [me.tonsky.persistent-sorted-set.arrays :as arrays]
    [me.tonsky.persistent-sorted-set.array-ops :as ops]
    [me.tonsky.persistent-sorted-set.search :as search]))

(def max-len 32)
(def min-len 16)

(type-record tree [value]
  (keys :ocaml/array<param/value>)
  (children :ocaml/array<tree<param/value>>)
  (_address :ocaml/option<string>)
  (_dirty :bool))

(defn- make-tree [keys children address dirty]
  (ocaml-record tree
    (keys keys)
    (children children)
    (_address address)
    (_dirty dirty)))

(defn new-leaf [keys]
  (make-tree keys (arrays/make-array 0) nil true))

(defn- new-leaf-address [keys address]
  (make-tree keys (arrays/make-array 0) address true))

(defn new-node [keys children]
  (make-tree keys children nil true))

(defn- new-node-address [keys children address]
  (make-tree keys children address true))

(defn node-lim-key [node]
  (arrays/alast (ocaml-field node keys)))

(defn node-len [node]
  (arrays/alength (ocaml-field node keys)))

(defn node-keys [node]
  (ocaml-field node keys))

(defn node-children [node]
  (ocaml-field node children))

(defn- node-merge [node next _storage]
  (make-tree
    (arrays/aconcat (ocaml-field node keys) (ocaml-field next keys))
    (arrays/aconcat (ocaml-field node children) (ocaml-field next children))
    (ocaml-field node _address)
    true))

(defn- node-merge-n-split [node next]
  (let [split-keys
        (ops/merge-n-split (ocaml-field node keys) (ocaml-field next keys))
        split-children
        (ops/merge-n-split
          (ocaml-field node children)
          (ocaml-field next children))]
    (arrays/array
      (make-tree
        (arrays/aget split-keys 0)
        (arrays/aget split-children 0)
        (ocaml-field node _address)
        true)
      (make-tree
        (arrays/aget split-keys 1)
        (arrays/aget split-children 1)
        (ocaml-field next _address)
        true))))

(defn- rotate [node root? left right storage]
  (cond
    root?
    (arrays/array node)

    (> (node-len node) min-len)
    (if-some [left-node left]
      (if-some [right-node right]
        (arrays/array left-node node right-node)
        (arrays/array left-node node))
      (if-some [right-node right]
        (arrays/array node right-node)
        (arrays/array node)))

    :else
    (if-some [left-node left]
      (if (<= (node-len left-node) min-len)
        (if-some [right-node right]
          (arrays/array (node-merge left-node node storage) right-node)
          (arrays/array (node-merge left-node node storage)))
        (if-some [right-node right]
          (if (<= (node-len right-node) min-len)
            (arrays/array left-node (node-merge node right-node storage))
            (if (< (node-len left-node) (node-len right-node))
              (let [nodes (node-merge-n-split left-node node)]
                (arrays/array
                  (arrays/aget nodes 0)
                  (arrays/aget nodes 1)
                  right-node))
              (let [nodes (node-merge-n-split node right-node)]
                (arrays/array
                  left-node
                  (arrays/aget nodes 0)
                  (arrays/aget nodes 1)))))
          (node-merge-n-split left-node node)))
      (if-some [right-node right]
        (if (<= (node-len right-node) min-len)
          (arrays/array (node-merge node right-node storage))
          (node-merge-n-split node right-node))
        (arrays/array node)))))

(defn node-lookup [node cmp key _storage]
  (loop [node node]
    (let [keys (ocaml-field node keys)
          children (ocaml-field node children)]
      (if (= 0 (arrays/alength children))
        (let [idx (search/lookup-exact cmp keys key)]
          (when-not (= -1 idx)
            (arrays/aget keys idx)))
        (let [idx (search/lookup-range cmp keys key)]
          (if (= -1 idx)
            nil
            (recur (arrays/aget children idx))))))))

(defn node-conj [node cmp key storage]
  (let [keys (ocaml-field node keys)
        children (ocaml-field node children)
        address (ocaml-field node _address)]
    (if (= 0 (arrays/alength children))
      (let [idx (search/binary-search-l cmp keys (dec (arrays/alength keys)) key)
            keys-length (arrays/alength keys)]
        (cond
          (and (< idx keys-length)
               (= 0 (cmp key (arrays/aget keys idx))))
          nil

          (= keys-length max-len)
          (let [middle (arrays/half (inc keys-length))]
            (if (> idx middle)
              (arrays/array
                (new-leaf-address (arrays/aslice keys 0 middle) address)
                (new-leaf
                  (ops/cut-n-splice
                    keys middle keys-length idx idx (arrays/array key))))
              (arrays/array
                (new-leaf-address
                  (ops/cut-n-splice
                    keys 0 middle idx idx (arrays/array key))
                  address)
                (new-leaf (arrays/aslice keys middle keys-length)))))

          :else
          (arrays/array
            (new-leaf-address
              (ops/splice keys idx idx (arrays/array key))
              address))))
      (let [idx (search/binary-search-l cmp keys (- (arrays/alength keys) 2) key)
            child (arrays/aget children idx)]
        (if-some [child-nodes (node-conj child cmp key storage)]
          (let [new-keys
                (ops/check-n-splice
                  cmp
                  keys
                  idx
                  (inc idx)
                  (arrays/amap (fn [child] (node-lim-key child)) child-nodes))
                new-children
                (ops/splice children idx (inc idx) child-nodes)]
            (if (<= (arrays/alength new-children) max-len)
              (arrays/array
                (new-node-address new-keys new-children address))
              (let [middle (arrays/half (arrays/alength new-children))]
                (arrays/array
                  (new-node-address
                    (arrays/aslice new-keys 0 middle)
                    (arrays/aslice new-children 0 middle)
                    address)
                  (new-node
                    (arrays/aslice new-keys middle (arrays/alength new-keys))
                    (arrays/aslice
                      new-children middle (arrays/alength new-children)))))))
          nil)))))

(defn node-disj [node cmp key root? left right storage]
  (let [keys (ocaml-field node keys)
        children (ocaml-field node children)]
    (if (= 0 (arrays/alength children))
      (let [idx (search/lookup-exact cmp keys key)]
        (if (= -1 idx)
          nil
          (rotate
            (new-leaf-address
              (ops/splice keys idx (inc idx) (arrays/make-array 0))
              (ocaml-field node _address))
            root?
            left
            right
            storage)))
      (let [idx (search/lookup-range cmp keys key)]
        (if (= -1 idx)
          nil
          (let [children-length (arrays/alength children)
                child (arrays/aget children idx)
                left-child
                (when (> idx 0)
                  (arrays/aget children (dec idx)))
                right-child
                (when (< (inc idx) children-length)
                  (arrays/aget children (inc idx)))]
            (if-some [disjoined
                      (node-disj
                        child cmp key false left-child right-child storage)]
              (let [left-idx (if (> idx 0) (dec idx) idx)
                    right-idx
                    (if (< (inc idx) children-length) (+ idx 2) (inc idx))
                    new-keys
                    (ops/check-n-splice
                      cmp
                      keys
                      left-idx
                      right-idx
                      (arrays/amap
                        (fn [child] (node-lim-key child))
                        disjoined))
                    new-children
                    (ops/splice children left-idx right-idx disjoined)]
                (rotate
                  (new-node-address
                    new-keys
                    new-children
                    (ocaml-field node _address))
                  root?
                  left
                  right
                  storage))
              nil)))))))
