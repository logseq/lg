(ns me.tonsky.persistent-sorted-set.nodes
  (:require
    [me.tonsky.persistent-sorted-set.arrays :as arrays]
    [me.tonsky.persistent-sorted-set.array-ops :as ops]
    [me.tonsky.persistent-sorted-set.search :as search]))

(def max-len 32)

(type-record tree [value]
  (keys :ocaml/array<param/value>)
  (children :ocaml/array<tree<param/value>>)
  (_address :ocaml/option<string>)
  (_dirty :bool))

(defn- make-tree [keys children address dirty]
  (ocaml-record tree
    (keys keys)
    (children children)
    (_address address)
    (_dirty dirty)))

(defn new-leaf [keys]
  (make-tree keys (arrays/make-array 0) nil true))

(defn- new-leaf-address [keys address]
  (make-tree keys (arrays/make-array 0) address true))

(defn new-node [keys children]
  (make-tree keys children nil true))

(defn- new-node-address [keys children address]
  (make-tree keys children address true))

(defn node-lim-key [node]
  (arrays/alast (ocaml-field node keys)))

(defn node-len [node]
  (arrays/alength (ocaml-field node keys)))

(defn node-lookup [node cmp key _storage]
  (loop [node node]
    (let [keys (ocaml-field node keys)
          children (ocaml-field node children)]
      (if (= 0 (arrays/alength children))
        (let [idx (search/lookup-exact cmp keys key)]
          (when-not (= -1 idx)
            (arrays/aget keys idx)))
        (let [idx (search/lookup-range cmp keys key)]
          (if (= -1 idx)
            nil
            (recur (arrays/aget children idx))))))))

(defn node-conj [node cmp key storage]
  (let [keys (ocaml-field node keys)
        children (ocaml-field node children)
        address (ocaml-field node _address)]
    (if (= 0 (arrays/alength children))
      (let [idx (search/binary-search-l cmp keys (dec (arrays/alength keys)) key)
            keys-length (arrays/alength keys)]
        (cond
          (and (< idx keys-length)
               (= 0 (cmp key (arrays/aget keys idx))))
          nil

          (= keys-length max-len)
          (let [middle (arrays/half (inc keys-length))]
            (if (> idx middle)
              (arrays/array
                (new-leaf-address (arrays/aslice keys 0 middle) address)
                (new-leaf
                  (ops/cut-n-splice
                    keys middle keys-length idx idx (arrays/array key))))
              (arrays/array
                (new-leaf-address
                  (ops/cut-n-splice
                    keys 0 middle idx idx (arrays/array key))
                  address)
                (new-leaf (arrays/aslice keys middle keys-length)))))

          :else
          (arrays/array
            (new-leaf-address
              (ops/splice keys idx idx (arrays/array key))
              address))))
      (let [idx (search/binary-search-l cmp keys (- (arrays/alength keys) 2) key)
            child (arrays/aget children idx)]
        (if-some [child-nodes (node-conj child cmp key storage)]
          (let [new-keys
                (ops/check-n-splice
                  cmp
                  keys
                  idx
                  (inc idx)
                  (arrays/amap (fn [child] (node-lim-key child)) child-nodes))
                new-children
                (ops/splice children idx (inc idx) child-nodes)]
            (if (<= (arrays/alength new-children) max-len)
              (arrays/array
                (new-node-address new-keys new-children address))
              (let [middle (arrays/half (arrays/alength new-children))]
                (arrays/array
                  (new-node-address
                    (arrays/aslice new-keys 0 middle)
                    (arrays/aslice new-children 0 middle)
                    address)
                  (new-node
                    (arrays/aslice new-keys middle (arrays/alength new-keys))
                    (arrays/aslice
                      new-children middle (arrays/alength new-children)))))))
          nil)))))
